title1;
data _null_; file "/work/files_sas_small/suppression/suppression_n100_del10_no.csv" lrecl=1000000;
  put "i,x,c";
run;
data _null_; set o.suppression_n100_del10_no; file "/work/files_sas_small/suppression/suppression_n100_del10_no.csv" mod dlm="," lrecl=1000000;
  put i :best32. x :best32. c :$quote7.;
