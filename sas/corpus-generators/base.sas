/* famille base : variantes COMPRESS=NO */
/* Genere par corpus/gen/build_programs.py : ne pas modifier a la main. */
options nodate nonumber linesize=200 pagesize=32000;
libname o "/work/files_sas_small/base";
data o.base_n0_mix_no(compress=no);
  length c $5; do i=1 to 0; x=i*1.5; c=put(i,z5.); output; end;
run;
title1 "@@@ base_n0_mix_no contents";
proc contents data=o.base_n0_mix_no; run;
title1 "@@@ base_n0_mix_no print";
proc print data=o.base_n0_mix_no; run;
title1;
data _null_; file "/work/files_sas_small/base/base_n0_mix_no.csv" lrecl=1000000;
  put "i,x,c";
run;
data _null_; set o.base_n0_mix_no; file "/work/files_sas_small/base/base_n0_mix_no.csv" mod dlm="," lrecl=1000000;
  put i :best32. x :best32. c :$quote7.;
run;
