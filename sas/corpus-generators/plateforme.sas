/* famille plateforme : variantes COMPRESS=NO */
/* Genere par corpus/gen/build_programs.py : ne pas modifier a la main. */
options nodate nonumber linesize=200 pagesize=32000;
libname o "/work/files_sas_small/plateforme";
data o.plateforme_linux_x86_64_no(compress=no outrep=LINUX_X86_64);
  length c $5; do i=1 to 100; x=i*1.5; c=put(i,z5.); output; end;
run;
title1 "@@@ plateforme_linux_x86_64_no contents";
proc contents data=o.plateforme_linux_x86_64_no; run;
title1 "@@@ plateforme_linux_x86_64_no print";
proc print data=o.plateforme_linux_x86_64_no; run;
title1;
data _null_; file "/work/files_sas_small/plateforme/plateforme_linux_x86_64_no.csv" lrecl=1000000;
  put "i,x,c";
run;
data _null_; set o.plateforme_linux_x86_64_no; file "/work/files_sas_small/plateforme/plateforme_linux_x86_64_no.csv" mod dlm="," lrecl=1000000;
  put i :best32. x :best32. c :$quote7.;
run;
