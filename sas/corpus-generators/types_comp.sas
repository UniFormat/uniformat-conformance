options nodate nonumber linesize=200 pagesize=32000;
libname o "/work/files_sas_small/types";
data o.types_num3_char(compress=char);
  length x 3; do i=1 to 20; x=i*1.25; output; end;
run;
title1 "@@@ types_num3_char contents";
proc contents data=o.types_num3_char; run;
title1 "@@@ types_num3_char print";
proc print data=o.types_num3_char; run;
title1;
data _null_; file "/work/files_sas_small/types/types_num3_char.csv" lrecl=1000000;
  put "i,x";
run;
data _null_; set o.types_num3_char; file "/work/files_sas_small/types/types_num3_char.csv" mod dlm="," lrecl=1000000;
  put i :best32. x :best32.;
run;
