/* famille encodage : variantes COMPRESS=NO */
/* Genere par corpus/gen/build_programs.py : ne pas modifier a la main. */
options nodate nonumber linesize=200 pagesize=32000;
libname o "/work/files_sas_small/encodage";
data o.encodage_utf8_no(compress=no encoding='utf-8');
  length c $20; c="Café été ñ"; output;
run;
title1 "@@@ encodage_utf8_no contents";
proc contents data=o.encodage_utf8_no; run;
title1 "@@@ encodage_utf8_no print";
proc print data=o.encodage_utf8_no; run;
title1;
data _null_; file "/work/files_sas_small/encodage/encodage_utf8_no.csv" lrecl=1000000;
  put "c";
run;
data _null_; set o.encodage_utf8_no; file "/work/files_sas_small/encodage/encodage_utf8_no.csv" mod dlm="," lrecl=1000000;
  put c :$quote22.;
run;
