options nodate nonumber linesize=200 pagesize=32000;
libname o "/work/files_sas_small/plateforme";
data o.plateforme_linux_x86_64_char(compress=char outrep=LINUX_X86_64);
  length c $5; do i=1 to 100; x=i*1.5; c=put(i,z5.); output; end;
run;
